  "narrative": {
    "northStar": "The Warm Editorial Collection",
    "overview": "MindVault presents saved knowledge as a personal visual collection. Warm surfaces, expressive Lora titles, and quiet Manrope controls give text-heavy material room to be recognized and revisited.\n\nEvidence stays close to every answer: source identity, truthful availability, summary provenance, extraction limitations, and PDF page references remain part of the reading experience.",
    "keyCharacteristics": [
      "Ivory and charcoal surfaces with aubergine actions.",
      "Self-hosted Lora and Manrope.",
      "Image, text, and document treatments with visible availability.",
      "Ordered collection, readable search results, spacious item overlay, and companion Ask.",
      "Reduced motion and persistent Light/Dark/System preference."
    ],
    "rules": [
      {
        "name": "Visible truth",
        "body": "Show availability in text and keep evidence qualifications with the relevant content.",
        "section": "typography"
      },
      {
        "name": "Quiet structure",
        "body": "Use whitespace and section labels; reserve separators for changes of context.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Use authentic source media and natural image ratios.",
      "Label source descriptions, personal notes, and verified summaries distinctly.",
      "Keep touch menus, focus restoration, and retries available."
    ],
    "donts": [
      "Do not fabricate document covers or imply every retained file is understood.",
      "Do not hide required actions or availability behind hover.",
      "Do not restore red legend panels, bouncing badges, or rotating loading slogans."
    ]
  }
