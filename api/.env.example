DATABASE_URL=postgres://username:password@localhost:5432/db
PORT=4000
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=db
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_GENERATION_MODEL=gemma3:latest
OLLAMA_EMBEDDING_MODEL=nomic-embed-text:latest
CLOUDINARY_CLOUD_NAME=name
CLOUDINARY_API_KEY=key
CLOUDINARY_API_SECRET=secret
# Only set for a Cloudinary product environment hosted in the EU or AP data center.
# CLOUDINARY_UPLOAD_PREFIX=https://api-eu.cloudinary.com
# Retained PDF worker (Node.js >=22.13 or >=24 must be on PATH)
# PDF_NODE_EXECUTABLE=/absolute/path/to/node
PDF_MAXIMUM_BYTES=52428800
PDF_MAXIMUM_PAGES=200
PDF_MAXIMUM_CHARACTERS=1000000
PDF_TIMEOUT_MS=30000
PDF_HEAP_MIB=256
# Local Tesseract 5 with English trained data; PDF.js optional canvas package must be installed.
# PDF_TESSERACT_EXECUTABLE=/absolute/path/to/tesseract
PDF_MAXIMUM_OCR_PAGES=20
PDF_RENDER_DPI=150
PDF_MAXIMUM_RENDER_PIXELS=8000000
PDF_MAXIMUM_TOTAL_RENDER_PIXELS=80000000
PDF_OCR_TIMEOUT_MS=5000
